  "weight_table": [
    {
      "id": "create_parameter_abstraction_standard",
      "label": "Create Parameter Abstraction Standard",
      "ai_targets": [
        "ChatGPT",
        "Codex"
      ],
      "applies_to_hooks": [
        "create_parameter_abstraction_gate"
      ],
      "weights": {
        "parameter_resolution_first": 10,
        "context_sorting_by_intensity": 10,
        "changed_files_only": 8,
        "schema_traceability": 9,
        "validation_honesty": 10
      },
      "rules": [
        "Resolve parameter schemas before Create context is sorted.",
        "Use Weight as context budget, not as confidence.",
        "Include parameter boilerplates and active context drivers in compact handoff files."
      ]
    }
  ],
  "hooks": [
    {
      "id": "create_parameter_abstraction_gate",
      "label": "Create Parameter Abstraction Gate",
      "lifecycle_phase": "create_context_build",
      "priority": 93,
      "target_path_types": [
        "wrapper",
        "backend",
        "frontend",
        "generated",
        "custom"
      ],
      "ai_targets": [
        "ChatGPT",
        "Codex"
      ],
      "boilerplate_profiles": [
        "Create",
        "DevelopFeatures",
        "Refactor",
        "CreateParameterPrecision",
        "CreateParameterArchitecture",
        "CreateParameterDocumentation",
        "CreateParameterUsability",
        "CreateParameterSecurity",
        "CreateParameterWeight"
      ],
      "file_types": [
        "json",
        "md",
        "yaml",
        "py",
        "dockerfile",
        "env"
      ],
      "weight_profile": "create_parameter_abstraction_standard",
      "weight_operator": "create_parameter_precision_weight_operator",
      "inject_into": [
        "create_prompt_contract",
        "create_project_mapping",
        "compact_export"
      ],
      "rules": [
        "Run after mode is known and before context chunks are sorted.",
        "Only active in feature_for_existing_project and refactor_existing_stack.",
        "Parameter boilerplates must be present for every declared slider."
      ]
    }
  ],
  "parameter_abstraction_rule": "Every Feature/Refactor slider owns one schema boilerplate, one reference, one operator role and one weight operator. The resolved values feed create_parameter_context before Create context sorting."
}

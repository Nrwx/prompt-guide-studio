{
  "code_structures": [
    {
      "id": "flask_generated_mvc",
      "label": "Flask Generated MVC",
      "path_type": "backend",
      "indicators": [
        "build.json",
        "generated/controller",
        "generated/model",
        "generated/view",
        "core"
      ],
      "file_types": [
        "py",
        "json"
      ],
      "rules": [
        "Treat build.json as the source of route/module truth.",
        "Prefer method_map extension over duplicate blueprints.",
        "Keep generated controller/model/view separation.",
        "Respect protected bootstrap/request-rewrite zones."
      ]
    },
    {
      "id": "vue_cli_build_frontend",
      "label": "Vue CLI Build Frontend",
      "path_type": "frontend",
      "indicators": [
        "package.json",
        "src",
        "public",
        "vue.config.js"
      ],
      "file_types": [
        "js",
        "vue",
        "scss",
        "json"
      ],
      "rules": [
        "Frontend is build-only unless project metadata says otherwise.",
        "Use npm run lint and npm run build as validation.",
        "Do not assume dev server availability.",
        "Centralize API services."
      ]
    },
    {
      "id": "texture_asset_pipeline",
      "label": "Texture Asset Pipeline",
      "path_type": "assets",
      "indicators": [
        "assets",
        "uploads",
        "exports",
        "prompts",
        "materials",
        "textures"
      ],
      "file_types": [
        "asset_image",
        "json",
        "md"
      ],
      "rules": [
        "Keep generated outputs separate from source assets.",
        "Preserve metadata and map semantics.",
        "Do not commit large generated binaries by default."
      ]
    },
    {
      "id": "schema_driven_ai_rules",
      "label": "Schema Driven AI Rules",
      "path_type": "wrapper",
      "indicators": [
        "AI_MANAGER.json",
        "AI-RULES.json",
        "schema"
      ],
      "file_types": [
        "json",
        "md"
      ],
      "rules": [
        "Schema is the operator layer.",
        "Wrapper delegates; it does not implement target-specific logic.",
        "All AI-readable rules remain English."
      ]
    },
    {
      "id": "vue_threejs_visual_frontend",
      "path_type": "frontend",
      "label": "Vue + ThreeJS Visual Frontend",
      "indicators": [
        "package.json",
        "src",
        "src/components",
        "src/render",
        "src/three",
        "src/webgl"
      ],
      "file_types": [
        "vue",
        "js",
        "ts",
        "scss",
        "shader",
        "scene_3d"
      ],
      "rules": [
        "Keep renderer lifecycle isolated from Vue reactivity.",
        "Dispose WebGL resources.",
        "Use component boundaries for controls and scene boundaries for rendering."
      ]
    },
    {
      "id": "blender_asset_pipeline",
      "path_type": "assets",
      "label": "Blender / 3D Asset Pipeline",
      "indicators": [
        "assets",
        "models",
        "textures",
        "materials",
        ".blend"
      ],
      "file_types": [
        "scene_3d",
        "asset_image",
        "shader",
        "json"
      ],
      "rules": [
        "Preserve source assets.",
        "Track material channels and color spaces.",
        "Write generated asset metadata."
      ]
    },
    {
      "id": "business_metrics_pipeline",
      "path_type": "generated",
      "label": "Business / Metrics Pipeline",
      "indicators": [
        "reports",
        "metrics",
        "analytics",
        "data",
        "exports"
      ],
      "file_types": [
        "data_table",
        "json",
        "py",
        "md"
      ],
      "rules": [
        "Keep formulas auditable.",
        "Preserve units, currency and reporting periods.",
        "Do not invent missing data."
      ]
    },
    {
      "id": "i18n_translation_tree",
      "path_type": "frontend",
      "label": "Localization / Translation Tree",
      "indicators": [
        "locales",
        "i18n",
        "translations",
        "src/i18n",
        "lang"
      ],
      "file_types": [
        "i18n",
        "json",
        "vue",
        "md"
      ],
      "rules": [
        "Preserve placeholders and keys.",
        "Translate values only when human-facing.",
        "Keep selected PROJECT_SCOPE as boundary."
      ]
    }
  ]
}

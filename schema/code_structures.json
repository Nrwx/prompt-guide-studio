{
  "artifact": "schema/code_structures.json",
  "schema_subset": "code_structures",
  "policy": "Resolved rows only; not a full schema catalog.",
  "code_structures": [
    {
      "id": "flask_generated_mvc",
      "label": "Flask Generated MVC",
      "path_type": "backend",
      "indicators": [
        "build.json",
        "generated/controller",
        "generated/model",
        "generated/view",
        "core"
      ],
      "file_types": [
        "py",
        "json"
      ],
      "rules": [
        "Treat build.json as the source of route/module truth.",
        "Prefer method_map extension over duplicate blueprints.",
        "Keep generated controller/model/view separation.",
        "Respect protected bootstrap/request-rewrite zones."
      ]
    },
    {
      "id": "texture_asset_pipeline",
      "label": "Texture Asset Pipeline",
      "path_type": "assets",
      "indicators": [
        "assets",
        "uploads",
        "exports",
        "prompts",
        "materials",
        "textures"
      ],
      "file_types": [
        "asset_image",
        "json",
        "md"
      ],
      "rules": [
        "Keep generated outputs separate from source assets.",
        "Preserve metadata and map semantics.",
        "Do not commit large generated binaries by default."
      ]
    },
    {
      "id": "schema_driven_ai_rules",
      "label": "Schema Driven AI Rules",
      "path_type": "wrapper",
      "indicators": [
        "AI-RULES.json",
        "AI-RULES.json",
        "schema"
      ],
      "file_types": [
        "json",
        "md"
      ],
      "rules": [
        "Schema is the operator layer.",
        "Wrapper delegates; it does not implement target-specific logic.",
        "All AI-readable rules remain English."
      ]
    },
    {
      "id": "blender_asset_pipeline",
      "path_type": "assets",
      "label": "Blender / 3D Asset Pipeline",
      "indicators": [
        "assets",
        "models",
        "textures",
        "materials",
        ".blend"
      ],
      "file_types": [
        "scene_3d",
        "asset_image",
        "shader",
        "json"
      ],
      "rules": [
        "Preserve source assets.",
        "Track material channels and color spaces.",
        "Write generated asset metadata."
      ]
    }
  ]
}
